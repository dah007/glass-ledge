<Window x:Class="GlassLedge.App.PaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder"
        Width="560"
        Height="460"
        MinWidth="360"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource BrandPageBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BrandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrandFooterBrush}"
                BorderBrush="{DynamicResource BrandHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <DockPanel>
                <Button x:Name="BackButton"
                        DockPanel.Dock="Left"
                        Content="Back"
                        MinWidth="64"
                        Margin="0,0,8,0"
                        ToolTip="Back (Alt+Left)"
                        AutomationProperties.Name="Back"
                        Style="{StaticResource BrandSecondaryButtonStyle}"
                        Click="Back_Click" />
                <Button x:Name="UpButton"
                        DockPanel.Dock="Left"
                        Content="Up"
                        MinWidth="64"
                        Margin="0,0,12,0"
                        ToolTip="Up one folder (Alt+Up)"
                        AutomationProperties.Name="Up one folder"
                        Style="{StaticResource BrandSecondaryButtonStyle}"
                        Click="Up_Click" />
                <TextBlock x:Name="PathText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrandSecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BrandFooterBrush}"
                BorderBrush="{DynamicResource BrandHairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{DynamicResource BrandSecondaryTextBrush}" />
        </Border>

        <ListBox x:Name="Items"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 SelectionMode="Single"
                 AutomationProperties.Name="Folder contents"
                 MouseDoubleClick="Items_MouseDoubleClick"
                 KeyDown="Items_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="2,3"
                                AutomationProperties.Name="{Binding SpokenName}">
                        <Image Source="{Binding Icon}"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
