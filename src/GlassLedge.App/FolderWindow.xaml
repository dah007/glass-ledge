<Window x:Class="GlassLedge.App.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:GlassLedge.App"
        Title="Folder widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <!-- Rename box: fits the 18 px title row and looks like the title, on a faint tile. -->
        <Style x:Key="TitleEditorStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource WidgetTextBrush}" />
            <Setter Property="MaxLength" Value="64" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{DynamicResource WidgetTileHoverBrush}" CornerRadius="4" Padding="3,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyboard focus ring for the whole card (shown when there are no tiles to focus). -->
        <Style x:Key="CardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="22" BorderThickness="3" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource WidgetAccentBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tile is a real button, so keyboard and screen-reader users can focus and open it. It has no
             chrome of its own; the focus ring is drawn on the tile square (see the template below). The
             mouse never reaches it: the card handles clicks first (see Card_PreviewMouseLeftButtonDown). -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent background so the whole cell is hit-testable. -->
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="Card"
            CornerRadius="22"
            Background="{DynamicResource WidgetTintBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="2"
            Padding="13,11,13,11"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False"
            FocusVisualStyle="{StaticResource CardFocusVisual}"
            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
            MouseMove="Card_MouseMove"
            MouseLeftButtonUp="Card_MouseLeftButtonUp">

        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened"
                         Background="{DynamicResource BrandMenuBrush}"
                         BorderBrush="{DynamicResource BrandHairlineBrush}">
                <MenuItem Header="Refresh" InputGestureText="F5" Click="Refresh_Click" />
                <MenuItem x:Name="CollapseItem" Header="Collapse" Click="ToggleCollapsed_Click" />
                <Separator />
                <MenuItem Header="Open in File Explorer" Click="OpenInExplorer_Click" />
                <MenuItem Header="Change folder…" Click="ChangeFolder_Click" />
                <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click" />
                <MenuItem Header="Color…" Click="Color_Click" />
                <MenuItem x:Name="GlossItem" Header="Glossy" IsCheckable="True" Click="Gloss_Click" />
                <!-- The empty icon reserves the same left column the check marks use, so "Size" lines up with its neighbours. -->
                <MenuItem Header="Size">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="SizeSmallItem" Header="Small" Tag="Small" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeMediumItem" Header="Medium" Tag="Medium" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeLargeItem" Header="Large" Tag="Large" IsCheckable="True" Click="Size_Click" />
                    <MenuItem x:Name="SizeExtraLargeItem" Header="Extra large" Tag="ExtraLarge" IsCheckable="True" Click="Size_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Add widget…" Click="AddWidget_Click" />
                <MenuItem x:Name="AddPluginMenu" Header="Add plugin widget" />
                <MenuItem Header="Remove widget" Click="RemoveWidget_Click" />
                <Separator />
                <MenuItem Header="Preferences…" Click="Preferences_Click" />
                <MenuItem Header="About" Click="About_Click" />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
        <!-- Glossy glass, under the content and over the tint (see WidgetPalette for the recipe). The
             negative margin cancels the card padding so the layers reach the card's inner edge. Purely
             decorative: never hit-testable, so clicks, drags and double-clicks reach the card. -->
        <Grid x:Name="Gloss" Margin="-13,-11" IsHitTestVisible="False" Focusable="False"
              Visibility="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}">
            <Border CornerRadius="20" Background="{DynamicResource WidgetGlossVeilBrush}" />
            <Border CornerRadius="20" Background="{DynamicResource WidgetGlossBrush}" />
            <Border CornerRadius="20" Background="{DynamicResource WidgetGlossStreakBrush}" />
        </Grid>

        <!-- Fixed to the expanded content height (set in code) and top-aligned, so while the widget
             collapses the tiles are clipped rather than squashed. -->
        <DockPanel x:Name="ContentPanel" VerticalAlignment="Top">
            <!-- Title row. Transparent background so double-clicking anywhere on it collapses/expands. -->
            <DockPanel x:Name="TitleRow" DockPanel.Dock="Top" Height="18" Margin="4,0,4,6" Background="Transparent">
                <!-- The item count sits in a small pill, the one soft shape in the header. -->
                <Border DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Padding="7,0"
                        Background="{DynamicResource WidgetTileBrush}">
                    <TextBlock x:Name="ItemCountText"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WidgetSecondaryTextBrush}" />
                </Border>
                <Grid>
                    <TextBlock x:Name="FolderNameText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource WidgetTextBrush}" />
                    <TextBox x:Name="NameEditor"
                             Style="{StaticResource TitleEditorStyle}"
                             Visibility="Collapsed"
                             Margin="-3,0,8,0"
                             AutomationProperties.Name="Widget name"
                             KeyDown="NameEditor_KeyDown"
                             LostKeyboardFocus="NameEditor_LostKeyboardFocus" />
                </Grid>
            </DockPanel>

            <!-- Arrow keys move between tiles; Tab enters the group once and the next Tab leaves it. -->
            <ItemsControl x:Name="Tiles" Focusable="False"
                          AutomationProperties.Name="Folder contents"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Once">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Rows="{Binding GridRows, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:TileViewModel}">
                        <Button Style="{StaticResource TileButtonStyle}"
                                Click="Tile_Click"
                                ToolTip="{Binding TargetPath}"
                                AutomationProperties.Name="{Binding SpokenName}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WidgetTileBrush}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WidgetTileEdgeBrush}" />
                                                </DataTrigger>
                                                <!-- Last, so the amber outline wins over the glossy rim while hovered. -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WidgetTileHoverBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WidgetAccentBrush}" />
                                                </Trigger>
                                                <!-- Keyboard focus: a thicker accent ring, the same in every theme. -->
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WidgetAccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- The tile's own small glare (glossy only). -->
                                        <Border CornerRadius="9" Background="{DynamicResource WidgetTileGlossBrush}" IsHitTestVisible="False"
                                                Visibility="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}" />
                                        <Image Source="{Binding Icon}"
                                               Width="32"
                                               Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding OverflowText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WidgetTextBrush}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Label}"
                                           Margin="0,2,0,0"
                                           MaxWidth="64"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource WidgetTextBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        </Grid>
    </Border>

    <!-- Glossy edge over the card's own 2 px border: a lighter shade of the tint along the top, a darker one along the bottom. -->
    <Border x:Name="GlossRim" CornerRadius="22" BorderThickness="2" IsHitTestVisible="False" Focusable="False"
            BorderBrush="{DynamicResource WidgetGlossRimBrush}"
            Visibility="{Binding IsGlossy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}" />
    </Grid>
</Window>
