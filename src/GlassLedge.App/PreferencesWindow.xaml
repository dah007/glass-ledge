<Window x:Class="GlassLedge.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource BrandPageBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BrandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" />
            </Style>
            <Style x:Key="RowDetailStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource BrandSecondaryTextBrush}" />
            </Style>
            <Style x:Key="IconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource BrandFooterBrush}" />
            </Style>
            <Style x:Key="IconPathStyle" TargetType="Path">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Stroke" Value="{DynamicResource BrandFocusBrush}" />
                <Setter Property="StrokeThickness" Value="1.75" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <StackPanel Margin="20,20,20,20">
            <Border Background="{DynamicResource BrandRowBrush}"
                    BorderBrush="{DynamicResource BrandHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="2">
                <StackPanel>
                    <CheckBox x:Name="StartSwitch"
                              Style="{StaticResource BrandSwitchRowStyle}"
                              AutomationProperties.Name="Start with Windows">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconTileStyle}">
                                <Path Style="{StaticResource IconPathStyle}"
                                      Data="M12,3 L12,11 M6.3,6.3 A8,8 0 1 0 17.7,6.3" />
                            </Border>
                            <StackPanel Width="250" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="StartDetail" Style="{StaticResource RowDetailStyle}"
                                           Text="Open GlassLedge in the tray when you sign in to Windows." />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <Rectangle Height="1" Margin="64,0,0,0" Fill="{DynamicResource BrandHairlineBrush}" />

                    <CheckBox x:Name="PaneSwitch"
                              Style="{StaticResource BrandSwitchRowStyle}"
                              AutomationProperties.Name="Open folders in a pane">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconTileStyle}">
                                <Path Style="{StaticResource IconPathStyle}"
                                      Data="M3,7 A3,3 0 0 1 6,4 L18,4 A3,3 0 0 1 21,7 L21,17 A3,3 0 0 1 18,20 L6,20 A3,3 0 0 1 3,17 Z M9,4 L9,20" />
                            </Border>
                            <StackPanel Width="250" VerticalAlignment="Center">
                                <TextBlock Text="Open folders in a pane" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Style="{StaticResource RowDetailStyle}"
                                           Text="Double-click a folder to browse it in a GlassLedge pane instead of File Explorer. Files still open in their own app." />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <Rectangle Height="1" Margin="64,0,0,0" Fill="{DynamicResource BrandHairlineBrush}" />

                    <CheckBox x:Name="PluginsSwitch"
                              Style="{StaticResource BrandSwitchRowStyle}"
                              AutomationProperties.Name="Allow plugins">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconTileStyle}">
                                <Path Style="{StaticResource IconPathStyle}"
                                      Data="M9,3 L9,8 M15,3 L15,8 M7,8 L17,8 L17,11 A5,5 0 0 1 7,11 Z M12,16 L12,21" />
                            </Border>
                            <StackPanel Width="250" VerticalAlignment="Center">
                                <TextBlock Text="Allow plugins" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Style="{StaticResource RowDetailStyle}"
                                           Text="Let GlassLedge load plugins from your plugins folder. Off by default." />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Plugins run code, so turning the switch on shows a plain warning. -->
            <Border Margin="0,12,0,0"
                    Padding="12,10"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BrandFocusBrush}"
                    Background="{DynamicResource BrandFooterBrush}"
                    AutomationProperties.Name="Plugin warning">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=PluginsSwitch}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource RowDetailStyle}"
                           Foreground="{DynamicResource BrandFocusBrush}"
                           Text="Plugins can run code on your PC. Turn this on only for plugins you trust." />
            </Border>
        </StackPanel>

        <Border Background="{DynamicResource BrandFooterBrush}"
                BorderBrush="{DynamicResource BrandHairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        MinWidth="88"
                        IsCancel="True"
                        Style="{StaticResource BrandSecondaryButtonStyle}" />
                <Button Content="OK"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Style="{StaticResource BrandPrimaryButtonStyle}"
                        Click="Ok_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
