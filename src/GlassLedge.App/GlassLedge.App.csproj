<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (System.Windows.Forms.NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GlassLedge.App</RootNamespace>
    <AssemblyName>GlassLedge</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>iOS-style folder widgets for the Windows desktop.</Description>
    <!-- Application.ThemeMode (Fluent theme that follows Windows light/dark + accent) is flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Settings used by `dotnet publish` for the installer: self-contained, so users don't need .NET installed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms types out of the global namespace so Application, MessageBox etc. stay WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded at runtime for the tray icon. -->
    <Resource Include="Assets\app.ico" />
    <!-- Shown at 64 px in the About dialog (an .ico would decode at its first, smallest size). -->
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlassLedge.Core\GlassLedge.Core.csproj" />
    <ProjectReference Include="..\GlassLedge.PluginApi\GlassLedge.PluginApi.csproj" />
  </ItemGroup>

  <!--
    Plugins shipped with the app. Each one is built from ./plugins/<name> and staged (see the plugin's own
    project) in artifacts/plugins/<configuration>/<name>. The references below only make sure they are built
    first; GlassLedge never links to them. The two targets then put the staged files in a "plugins" folder
    beside the executable, for a normal build and for publish (installer and Store package). To ship another
    plugin, add one ProjectReference line here.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\search-box\SearchBox.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <StagedPluginsDir>$(MSBuildThisFileDirectory)..\..\artifacts\plugins\$(Configuration)\</StagedPluginsDir>
  </PropertyGroup>

  <Target Name="CopyShippedPluginsToOutput" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_StagedPluginFile Include="$(StagedPluginsDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StagedPluginFile)"
          DestinationFiles="@(_StagedPluginFile->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddShippedPluginsToPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_StagedPluginPublishFile Include="$(StagedPluginsDir)**\*" />
      <ResolvedFileToPublish Include="@(_StagedPluginPublishFile)">
        <RelativePath>plugins\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
