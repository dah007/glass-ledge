<Window x:Class="GlassLedge.App.PluginWidgetWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- The glass: the same card, rim colours and sheen as a folder widget. The plugin's contents go in BodyHost. -->
    <Border x:Name="Card"
            CornerRadius="22"
            Background="{DynamicResource WidgetTintBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="2"
            Padding="10"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">

        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed"
                         Background="{DynamicResource BrandMenuBrush}"
                         BorderBrush="{DynamicResource BrandHairlineBrush}">
                <MenuItem Header="Color…" Click="Color_Click" />
                <MenuItem x:Name="GlossItem" Header="Glossy" IsCheckable="True" Click="Gloss_Click" />
                <MenuItem x:Name="LayerItem" Header="Layer" />
                <Separator />
                <MenuItem Header="Remove widget" Click="Remove_Click" />
                <Separator />
                <MenuItem Header="Add widget…" Click="AddWidget_Click" />
                <MenuItem x:Name="AddPluginMenu" Header="Add plugin widget" />
                <Separator />
                <MenuItem Header="Preferences…" Click="Preferences_Click" />
                <MenuItem Header="About" Click="About_Click" />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Glossy glass, under the contents and over the tint. Decorative only: never hit-testable. -->
            <Grid x:Name="Gloss" Margin="-10" IsHitTestVisible="False" Focusable="False">
                <Border CornerRadius="20" Background="{DynamicResource WidgetGlossVeilBrush}" />
                <Border CornerRadius="20" Background="{DynamicResource WidgetGlossBrush}" />
                <Border CornerRadius="20" Background="{DynamicResource WidgetGlossStreakBrush}" />
            </Grid>

            <!-- The plugin's body is placed here, sized to the "size" in plugin.json. -->
            <Border x:Name="BodyHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
