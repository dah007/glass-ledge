<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the plugins in ./plugins. One folder here can hold the tests for all of them. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlassLedge.PluginApi\GlassLedge.PluginApi.csproj" />
    <ProjectReference Include="..\..\src\GlassLedge.Core\GlassLedge.Core.csproj" />
    <ProjectReference Include="..\..\plugins\search-box\SearchBox.csproj" />
  </ItemGroup>

</Project>
